<Window x:Class="SpeakerDspDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speaker DSP" Height="820" Width="640"
        Background="{StaticResource Page}" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>

      <!-- Header -->
      <Grid Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Speaker DSP" Style="{StaticResource H1}"/>
          <TextBlock Text="Active crossover · 2-way stereo" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{StaticResource Muted}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Connected}" Value="True">
                    <Setter Property="Fill" Value="#57A773"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Muted}"/>
          <Button Content="Connect" Style="{StaticResource Accented}" Command="{Binding ConnectCommand}"/>
        </StackPanel>
      </Grid>

      <!-- Profile + master -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <TextBlock Text="OUTPUT" Style="{StaticResource H2}"/>
          <CheckBox IsChecked="{Binding IsHiRes}" Margin="0,0,0,10">
            <TextBlock>
              <Run Text="High-Res mode"/>
              <Run Text=" — WiFi 24/96  (off = Normal, USB 24/48)" Foreground="{StaticResource Muted}" FontSize="11"/>
            </TextBlock>
          </CheckBox>

          <TextBlock Text="{Binding MasterPct, StringFormat='Master volume: {0:0}%'}" Margin="0,4,0,0"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding MasterPct}"/>

          <CheckBox Content="Mute (amps)" IsChecked="{Binding Muted}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- Crossover -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <TextBlock Text="CROSSOVER (LR4)" Style="{StaticResource H2}"/>
          <TextBlock Text="{Binding CrossoverHz, StringFormat='Frequency: {0:0} Hz'}"/>
          <Slider Minimum="500" Maximum="6000" Value="{Binding CrossoverHz}"/>
          <TextBlock Text="{Binding VoicingPreampDb, StringFormat='Voicing preamp: {0:0.0} dB'}" Margin="0,8,0,0"/>
          <Slider Minimum="-20" Maximum="6" Value="{Binding VoicingPreampDb}"/>
        </StackPanel>
      </Border>

      <!-- Voicing EQ -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="VOICING EQ (pre-crossover)" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            <Button Content="Import Peace / AutoEQ…" Style="{StaticResource Accented}"
                    HorizontalAlignment="Right" Command="{Binding ImportEqCommand}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Voicing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Margin="2,0"/>
                  <TextBox Grid.Column="2" Text="{Binding F, StringFormat='{}{0:0}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Freq (Hz)"/>
                  <TextBox Grid.Column="3" Text="{Binding Q, StringFormat='{}{0:0.00}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Q"/>
                  <TextBox Grid.Column="4" Text="{Binding GainDb, StringFormat='{}{0:0.0}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Gain (dB)"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="cols: on · type · Hz · Q · dB" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- Per-driver: level + time-align + EQ (post-crossover) -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <TextBlock Text="PER-DRIVER (post-crossover)" Style="{StaticResource H2}"/>

          <!-- driver selector -->
          <ListBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name"
                   SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" Margin="0,0,0,10">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,6"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="b" CornerRadius="6" Background="{StaticResource Page}"
                              BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                          <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>

          <!-- level -->
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="-24" Maximum="6" Value="{Binding SelectedDriver.LevelDb}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding SelectedDriver.LevelDb, StringFormat='{}{0:0.0} dB'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <!-- delay / time-align -->
          <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Delay" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding SelectedDriver.DelayMs}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding SelectedDriver.DelayMs, StringFormat='{}{0:0.00} ms'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <TextBlock Text="Driver EQ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
          <ItemsControl ItemsSource="{Binding SelectedDriver.Eq}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Margin="2,0"/>
                  <TextBox Grid.Column="2" Text="{Binding F, StringFormat='{}{0:0}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Freq (Hz)"/>
                  <TextBox Grid.Column="3" Text="{Binding Q, StringFormat='{}{0:0.00}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Q"/>
                  <TextBox Grid.Column="4" Text="{Binding GainDb, StringFormat='{}{0:0.0}', UpdateSourceTrigger=LostFocus}" Margin="2,0" ToolTip="Gain (dB)"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="cols: on · type · Hz · Q · dB" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- Presets -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <TextBlock Text="PRESETS" Style="{StaticResource H2}"/>
          <ItemsControl ItemsSource="{Binding Presets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                  <Button Grid.Column="3" Content="Save" Command="{Binding SaveCommand}" Padding="12,5" Margin="4,0" Cursor="Hand"/>
                  <Button Grid.Column="4" Content="Load" Command="{Binding LoadCommand}" Padding="12,5" Margin="4,0" Cursor="Hand"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Save captures the current tuning; Load pushes it back to the device." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Button Content="Save current settings to device (NVS)" Style="{StaticResource Accented}"
              HorizontalAlignment="Left" Command="{Binding SaveNvsCommand}" Margin="0,0,0,12"/>

      <!-- Log -->
      <Border Style="{StaticResource CardPanel}">
        <StackPanel>
          <TextBlock Text="LOG" Style="{StaticResource H2}"/>
          <ItemsControl ItemsSource="{Binding LogLines}" MaxHeight="140">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
