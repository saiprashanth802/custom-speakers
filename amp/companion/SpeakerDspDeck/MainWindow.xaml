<Window x:Class="SpeakerDspDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SpeakerDspDeck.Controls"
        Title="Speaker DSP" Height="860" Width="980" MinWidth="900" MinHeight="600"
        Background="{StaticResource Void}" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- One EQ band row. BandRow and DriverBandRow expose the same members. -->
    <DataTemplate x:Key="BandRowTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Margin="0,0,6,0"/>
        <TextBox Grid.Column="2" Text="{Binding F, StringFormat='{}{0:0}', UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Frequency (Hz)"/>
        <TextBox Grid.Column="3" Text="{Binding Q, StringFormat='{}{0:0.00}', UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" ToolTip="Q"/>
        <TextBox Grid.Column="4" Text="{Binding GainDb, StringFormat='{}{0:0.0}', UpdateSourceTrigger=LostFocus}" ToolTip="Gain (dB)"/>
      </Grid>
    </DataTemplate>
    <!-- Column caption above the rows. -->
    <DataTemplate x:Key="BandHeader">
      <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/><ColumnDefinition Width="96"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="on"   Style="{StaticResource Hint}"/>
        <TextBlock Grid.Column="1" Text="type" Style="{StaticResource Hint}"/>
        <TextBlock Grid.Column="2" Text="Hz"   Style="{StaticResource Hint}"/>
        <TextBlock Grid.Column="3" Text="Q"    Style="{StaticResource Hint}"/>
        <TextBlock Grid.Column="4" Text="dB"   Style="{StaticResource Hint}"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= Title bar ================= -->
    <Grid Grid.Row="0" Background="{StaticResource Void}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
        <!-- The one warm light: breathes while searching, holds steady once linked. -->
        <Grid Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
          <Ellipse Width="22" Height="22" Margin="-7" Fill="{StaticResource EmberHalo}"/>
        <Ellipse Width="8" Height="8" Fill="{StaticResource Ember}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="False">
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="breathe">
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:1.6">
                          <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="breathe"/>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        </Grid>
        <TextBlock Text="Speaker DSP" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Dim}" FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
        <TextBlock Style="{StaticResource MonoMuted}" VerticalAlignment="Center" Margin="0,0,14,0">
          <Run Text="device "/><Run Text="{Binding DeviceRateText, Mode=OneWay}" Foreground="{StaticResource Bone}"/>
        </TextBlock>
        <Button Content="Connect" Command="{Binding ConnectCommand}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="&#xE921;" Style="{StaticResource Glyph}" Click="Minimise_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise"/>
        <Button Content="&#xE8BB;" Style="{StaticResource Glyph}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- ================= Content ================= -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,6,18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.02*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==== Left: hero + output + crossover + presets ==== -->
        <StackPanel Grid.Column="0">

          <Border Style="{StaticResource HeroPanel}">
            <Grid>
              <c:ResponseCurve Data="{Binding ResponseCurve}" Height="250"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,10,0">
                <TextBlock Text="voicing" Style="{StaticResource Hint}" Foreground="#4FC3FF" Margin="0,0,10,0"/>
                <TextBlock Text="crossover" Style="{StaticResource Hint}" Foreground="#8AFFB24D"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <TextBlock Text="OUTPUT" Style="{StaticResource H2}"/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsHiRes}" VerticalAlignment="Center">
                  <TextBlock>
                    <Run Text="High-Res"/>
                    <Run Text="  USB · 24/96, follows the host while it streams" Foreground="{StaticResource Dim}" FontSize="11"/>
                  </TextBlock>
                </CheckBox>
                <CheckBox Grid.Column="1" Content="Mute" Style="{StaticResource DangerToggle}" IsChecked="{Binding Muted}" VerticalAlignment="Center"/>
              </Grid>

              <Grid Margin="0,0,0,4">
                <TextBlock Text="Master" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding MasterPct, StringFormat='{}{0:0} %'}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="0" Maximum="100" Value="{Binding MasterPct}"/>

              <Button Content="Save to device" Style="{StaticResource Accented}" Command="{Binding SaveNvsCommand}"
                      HorizontalAlignment="Left" Margin="0,14,0,0" ToolTip="Persist the current tuning as the boot default (NVS)"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <TextBlock Text="CROSSOVER · LR4" Style="{StaticResource H2}"/>
              <Grid Margin="0,0,0,4">
                <TextBlock Text="Frequency" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding CrossoverHz, StringFormat='{}{0:0} Hz'}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="500" Maximum="6000" Value="{Binding CrossoverHz}" IsEnabled="{Binding CrossoverSliderEnabled}"/>
              <CheckBox IsChecked="{Binding FullRangeCheck}" Margin="0,8,0,0">
                <TextBlock>
                  <Run Text="Full-range check"/>
                  <Run Text="  LOW DAC carries everything · IEMs on its jack, amps off" Foreground="{StaticResource Dim}" FontSize="11"/>
                </TextBlock>
              </CheckBox>
              <Grid Margin="0,12,0,4">
                <TextBlock Text="Voicing preamp" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding VoicingPreampDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="-20" Maximum="6" Value="{Binding VoicingPreampDb}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <TextBlock Text="PRESETS" Style="{StaticResource H2}"/>
              <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Background="{StaticResource Void}" BorderThickness="1" Padding="10,10,10,8" Margin="0,0,8,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="True">
                              <Setter Property="BorderBrush" Value="#66FFB24D"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <Grid Margin="0,0,0,10">
                          <TextBlock Text="{Binding Slot}" FontSize="18" FontWeight="Light"/>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <UniformGrid Rows="1">
                          <Button Content="Save" Command="{Binding SaveCommand}" Padding="0,4" Margin="0,0,3,0" FontSize="11"/>
                          <Button Content="Load" Command="{Binding LoadCommand}" Padding="0,4" Margin="3,0,0,0" FontSize="11"/>
                        </UniformGrid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Save captures this tuning; Load pushes it back to the device." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ==== Right: voicing EQ + per-driver ==== -->
        <StackPanel Grid.Column="2">

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="VOICING EQ · pre-crossover" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                <Button Content="Import Peace / AutoEQ…" HorizontalAlignment="Right" Command="{Binding ImportEqCommand}" Padding="10,4" FontSize="11"/>
              </Grid>
              <ContentControl ContentTemplate="{StaticResource BandHeader}"/>
              <ItemsControl ItemsSource="{Binding Voicing}" ItemTemplate="{StaticResource BandRowTemplate}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardPanel}">
            <StackPanel>
              <TextBlock Text="PER-DRIVER · post-crossover" Style="{StaticResource H2}"/>

              <ListBox ItemsSource="{Binding Drivers}" DisplayMemberPath="Name"
                       SelectedIndex="{Binding SelectedDriverIndex, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource SegmentItem}"
                       BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hair}" Background="Transparent" Margin="0,0,0,14">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>

              <Grid Margin="0,0,0,4">
                <TextBlock Text="Level" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding SelectedDriver.LevelDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="-24" Maximum="6" Value="{Binding SelectedDriver.LevelDb}"/>

              <Grid Margin="0,12,0,4">
                <TextBlock Text="Delay · time-align" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding SelectedDriver.DelayMs, StringFormat='{}{0:0.00} ms'}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
              </Grid>
              <Slider Minimum="0" Maximum="10" Value="{Binding SelectedDriver.DelayMs}"/>

              <TextBlock Text="DRIVER EQ" Style="{StaticResource H2}" Margin="0,18,0,8"/>
              <ContentControl ContentTemplate="{StaticResource BandHeader}"/>
              <ItemsControl ItemsSource="{Binding SelectedDriver.Eq}" ItemTemplate="{StaticResource BandRowTemplate}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ================= Footer log strip ================= -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0">
      <StackPanel>
        <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Log_Toggle" Height="28">
          <TextBlock Text="{Binding LatestLog}" Style="{StaticResource MonoMuted}" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis"/>
          <Path Data="M0,4 L4,0 L8,4" Stroke="{StaticResource Dim}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
            <Path.Style>
              <Style TargetType="Path">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding LogExpanded}" Value="True">
                    <Setter Property="Data" Value="M0,0 L4,4 L8,0"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </Grid>
        <ScrollViewer MaxHeight="170" Margin="18,0,18,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding LogExpanded, Converter={StaticResource BoolVis}}">
          <ItemsControl ItemsSource="{Binding LogLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource MonoMuted}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
